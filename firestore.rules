rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function tripData(tripId) {
      return get(tripPath(tripId)).data;
    }

    function tripDataAfter(tripId) {
      return getAfter(tripPath(tripId)).data;
    }

    function validRole(role) {
      return role in ['owner', 'editor', 'viewer'];
    }

    function canReadTrip(tripId) {
      return signedIn() &&
        exists(tripPath(tripId)) &&
        request.auth.uid in tripData(tripId).memberIds;
    }

    function canReadTripResource() {
      return signedIn() &&
        resource.data.memberIds is list &&
        request.auth.uid in resource.data.memberIds;
    }

    function roleForTrip(tripId) {
      return tripData(tripId).roles[request.auth.uid];
    }

    function roleForTripAfter(tripId) {
      return tripDataAfter(tripId).roles[request.auth.uid];
    }

    function isOwner(tripId) {
      return canReadTrip(tripId) && roleForTrip(tripId) == 'owner';
    }

    function isEditor(tripId) {
      return canReadTrip(tripId) && roleForTrip(tripId) == 'editor';
    }

    function canEditTrip(tripId) {
      return isOwner(tripId) || isEditor(tripId);
    }

    function canEditTripAfter(tripId) {
      return signedIn() && roleForTripAfter(tripId) in ['owner', 'editor'];
    }

    function canCreateOwnedTrip() {
      return signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.roles is map &&
        request.resource.data.roles[request.auth.uid] == 'owner';
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chat_groups/$(chatId);
    }

    function chatMemberPath(chatId, userId) {
      return /databases/$(database)/documents/chat_groups/$(chatId)/members/$(userId);
    }

    function chatInvitePath(inviteCode) {
      return /databases/$(database)/documents/chat_invites/$(inviteCode);
    }

    function chatData(chatId) {
      return get(chatPath(chatId)).data;
    }

    function chatDataAfter(chatId) {
      return getAfter(chatPath(chatId)).data;
    }

    function validChatRole(role) {
      return role in ['owner', 'admin', 'member'];
    }

    function validChatMemberStatus(status) {
      return status in ['active', 'invited', 'left'];
    }

    function validChatInviteStatus(status) {
      return status in ['pending', 'accepted', 'rejected', 'expired'];
    }

    function isChatActiveMember(chatId, userId) {
      return signedIn() &&
        exists(chatPath(chatId)) &&
        userId in chatData(chatId).memberIds &&
        exists(chatMemberPath(chatId, userId)) &&
        get(chatMemberPath(chatId, userId)).data.status == 'active';
    }

    function isChatActiveMemberAfter(chatId, userId) {
      return signedIn() &&
        existsAfter(chatPath(chatId)) &&
        userId in chatDataAfter(chatId).memberIds &&
        existsAfter(chatMemberPath(chatId, userId)) &&
        getAfter(chatMemberPath(chatId, userId)).data.status == 'active';
    }

    function isChatInvitedMemberAfter(chatId, userId) {
      return signedIn() &&
        existsAfter(chatPath(chatId)) &&
        existsAfter(chatMemberPath(chatId, userId)) &&
        getAfter(chatMemberPath(chatId, userId)).data.status == 'invited';
    }

    function canReadChat(chatId) {
      return isChatActiveMember(chatId, request.auth.uid);
    }

    function canManageChat(chatId) {
      return isChatActiveMember(chatId, request.auth.uid) &&
        chatData(chatId).roles[request.auth.uid] in ['owner', 'admin'];
    }

    function isChatOwner(chatId) {
      return isChatActiveMember(chatId, request.auth.uid) &&
        chatData(chatId).ownerId == request.auth.uid &&
        chatData(chatId).roles[request.auth.uid] == 'owner';
    }

    function canInviteToChat(chatId) {
      return isChatActiveMember(chatId, request.auth.uid);
    }

    function canCreateOwnedChat() {
      return signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.roles is map &&
        request.resource.data.roles[request.auth.uid] == 'owner';
    }

    function chatLastMessageFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lastMessageText',
        'lastMessageAt',
        'updatedAt',
      ]);
    }

    function chatMemberFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'memberIds',
        'roles',
        'updatedAt',
      ]);
    }

    function chatManagementFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'description',
        'memberIds',
        'roles',
        'updatedAt',
      ]);
    }

    function preservesChatOwner() {
      return request.resource.data.ownerId == resource.data.ownerId &&
        resource.data.ownerId in request.resource.data.memberIds &&
        request.resource.data.roles[resource.data.ownerId] == 'owner';
    }

    function validManagedChatUpdate(chatId) {
      return canManageChat(chatId) &&
        chatManagementFieldsOnly() &&
        preservesChatOwner();
    }

    function isLeavingChat(chatId, userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        isChatActiveMember(chatId, userId) &&
        userId != resource.data.ownerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds',
          'roles',
          'updatedAt',
        ]) &&
        request.resource.data.memberIds.size() ==
          resource.data.memberIds.size() - 1 &&
        !(userId in request.resource.data.memberIds) &&
        request.resource.data.memberIds.toSet().hasOnly(
          resource.data.memberIds
        ) &&
        request.resource.data.roles.diff(resource.data.roles)
          .removedKeys().hasOnly([userId]) &&
        request.resource.data.roles.diff(resource.data.roles)
          .addedKeys().size() == 0 &&
        request.resource.data.roles.diff(resource.data.roles)
          .changedKeys().size() == 0 &&
        preservesChatOwner();
    }

    function validChatMessageCreate() {
      return request.resource.data.keys().hasOnly([
        'senderId',
        'senderNameSnapshot',
        'senderPhotoUrlSnapshot',
        'text',
        'type',
        'attachments',
        'createdAt',
        'editedAt',
      ]) &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 10000 &&
        request.resource.data.type in [
          'text',
          'attachment',
          'system',
          'ai',
          'trip_update',
        ] &&
        request.resource.data.attachments is list &&
        request.resource.data.attachments.size() <= 1;
    }

    function validChatInviteCreate(inviteCode) {
      return request.resource.data.inviteCode == inviteCode &&
        request.resource.data.chatId is string &&
        request.resource.data.titleSnapshot is string &&
        validChatRole(request.resource.data.role) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.invitedBy == request.auth.uid;
    }

    function canCreateChatInvite(inviteCode) {
      return signedIn() &&
        validChatInviteCreate(inviteCode) &&
        canInviteToChat(request.resource.data.chatId);
    }

    function chatInviteCanBeUsed(inviteCode, chatId, userId) {
      return signedIn() &&
        exists(chatInvitePath(inviteCode)) &&
        get(chatInvitePath(inviteCode)).data.chatId == chatId &&
        get(chatInvitePath(inviteCode)).data.status == 'pending' &&
        (
          get(chatInvitePath(inviteCode)).data.inviteeUid == null ||
          get(chatInvitePath(inviteCode)).data.inviteeUid == userId
        );
    }

    function isAcceptingChatInvite(chatId, userId) {
      return isChatActiveMemberAfter(chatId, userId) &&
        getAfter(chatMemberPath(chatId, userId)).data.inviteCode != null &&
        chatInviteCanBeUsed(
          getAfter(chatMemberPath(chatId, userId)).data.inviteCode,
          chatId,
          userId
        ) &&
        request.resource.data.roles[userId] ==
          get(chatInvitePath(getAfter(chatMemberPath(chatId, userId)).data.inviteCode)).data.role;
    }

    function chatInviteResolutionOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'updatedAt',
      ]) &&
        validChatInviteStatus(request.resource.data.status);
    }

    function canResolveChatInvite() {
      return signedIn() &&
        resource.data.status == 'pending' &&
        chatInviteResolutionOnly() &&
        request.resource.data.status in ['accepted', 'rejected', 'expired'] &&
        (
          resource.data.inviteeUid == null ||
          resource.data.inviteeUid == request.auth.uid ||
          resource.data.invitedBy == request.auth.uid ||
          canInviteToChat(resource.data.chatId)
        );
    }

    function validUserChatMembership(chatId) {
      return request.resource.data.chatId == chatId &&
        validChatRole(request.resource.data.role) &&
        validChatMemberStatus(request.resource.data.status) &&
        (
          !request.resource.data.keys().hasAny(['mutedForever']) ||
          request.resource.data.mutedForever is bool
        ) &&
        (
          !request.resource.data.keys().hasAny(['mutedUntil']) ||
          request.resource.data.mutedUntil == null ||
          request.resource.data.mutedUntil is timestamp
        );
    }

    function chatMembershipSnapshotFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'chatId',
        'titleSnapshot',
        'lastMessageText',
        'lastMessageAt',
        'unreadCount',
        'updatedAt',
      ]);
    }

    function chatMembershipPreferenceFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'mutedForever',
        'mutedUntil',
        'updatedAt',
      ]);
    }

    function chatMembershipLeaveFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'updatedAt',
      ]) &&
        request.resource.data.status == 'left';
    }

    function chatMembershipManagementFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'role',
        'status',
        'updatedAt',
      ]) &&
        request.resource.data.role in ['admin', 'member'];
    }

    function chatMembershipInviteAcceptanceOnly() {
      return resource.data.status == 'invited' &&
        request.resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'chatId',
          'role',
          'status',
          'titleSnapshot',
          'lastMessageText',
          'lastMessageAt',
          'unreadCount',
          'mutedUntil',
          'mutedForever',
          'updatedAt',
        ]);
    }

    function editorTripFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'destination',
        'placeId',
        'formattedAddress',
        'latitude',
        'longitude',
        'startDate',
        'endDate',
        'budget',
        'spent',
        'currency',
        'status',
        'numOfTravelers',
        'images',
        'preferences',
        'checklist',
        'updatedAt',
      ]);
    }

    function validTravelUserSettings() {
      return !request.resource.data.keys().hasAny(['settings']) ||
        (
          request.resource.data.settings is map &&
          (
            !request.resource.data.settings.keys().hasAny(['onboardingRequired']) ||
            request.resource.data.settings.onboardingRequired is bool
          ) &&
          (
            !request.resource.data.settings.keys().hasAny(['onboardingCompleted']) ||
            request.resource.data.settings.onboardingCompleted is bool
          ) &&
          (
            !request.resource.data.settings.keys().hasAny(['displayCurrencyCode']) ||
            (
              request.resource.data.settings.displayCurrencyCode is string &&
              request.resource.data.settings.displayCurrencyCode.size() == 3
            )
          ) &&
          (
            !request.resource.data.settings.keys().hasAny(['currencyUpdateMode']) ||
            request.resource.data.settings.currencyUpdateMode in
              ['automatic', 'manual']
          ) &&
          (
            !request.resource.data.settings.keys().hasAny(['currencySettingsVersion']) ||
            request.resource.data.settings.currencySettingsVersion is int
          )
        );
    }

    function canWriteOwnTravelUser(userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        validTravelUserSettings();
    }

    match /travel_users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if canWriteOwnTravelUser(userId);
      allow delete: if signedIn() && request.auth.uid == userId;

      match /tripMemberships/{tripId} {
        allow read: if signedIn() &&
          (request.auth.uid == userId || canReadTrip(tripId));
        allow create, update: if signedIn() &&
          request.resource.data.tripId == tripId &&
          validRole(request.resource.data.role) &&
          (
            request.auth.uid == userId ||
            canEditTrip(tripId) ||
            canEditTripAfter(tripId)
          );
        allow delete: if signedIn() &&
          (request.auth.uid == userId || canEditTrip(tripId));
      }

      match /trips/{tripId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if false;
      }

      match /tripMemories/{memoryId} {
        allow read, create, update, delete: if signedIn() &&
          request.auth.uid == userId;
      }

      match /notificationTokens/{tokenId} {
        allow read, create, update, delete: if signedIn() &&
          request.auth.uid == userId;
      }

      match /chatMemberships/{chatId} {
        allow read: if signedIn() &&
          (request.auth.uid == userId || canReadChat(chatId));
        allow create: if signedIn() &&
          validUserChatMembership(chatId) &&
          (
            (
              request.auth.uid == userId &&
              (
                isChatActiveMemberAfter(chatId, userId) ||
                isChatInvitedMemberAfter(chatId, userId) ||
                request.resource.data.status == 'left'
              )
            ) ||
            (
              canInviteToChat(chatId) &&
              isChatInvitedMemberAfter(chatId, userId)
            )
          );
        allow update: if signedIn() &&
          validUserChatMembership(chatId) &&
          (
            (
              request.auth.uid == userId &&
              (
                (
                  isChatActiveMember(chatId, userId) &&
                  isChatActiveMemberAfter(chatId, userId) &&
                  chatMembershipPreferenceFieldsOnly()
                ) ||
                chatMembershipInviteAcceptanceOnly() ||
                (
                  userId != chatData(chatId).ownerId &&
                  chatMembershipLeaveFieldsOnly()
                )
              )
            ) ||
            (
              canInviteToChat(chatId) &&
              isChatInvitedMemberAfter(chatId, userId)
            ) ||
            (
              isChatActiveMember(chatId, request.auth.uid) &&
              chatMembershipSnapshotFieldsOnly()
            ) ||
            (
              canManageChat(chatId) &&
              userId != chatData(chatId).ownerId &&
              chatMembershipManagementFieldsOnly()
            )
          );
        allow delete: if signedIn() &&
          (request.auth.uid == userId || canManageChat(chatId));
      }

      match /chatInvites/{inviteCode} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if canCreateChatInvite(inviteCode) &&
          request.resource.data.inviteeUid == userId;
        allow update: if signedIn() &&
          (
            (request.auth.uid == userId && canResolveChatInvite()) ||
            canCreateChatInvite(inviteCode)
          );
        allow delete: if signedIn() &&
          (
            request.auth.uid == userId ||
            canInviteToChat(resource.data.chatId)
          );
      }
    }

    match /public_users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      allow read: if canReadTripResource();
      allow create: if canCreateOwnedTrip();
      allow update: if isOwner(tripId) ||
        (isEditor(tripId) && editorTripFieldsOnly());
      allow delete: if isOwner(tripId);

      match /members/{userId} {
        allow read: if canReadTrip(tripId);
        allow create, update: if isOwner(tripId) ||
          (
            signedIn() &&
            request.auth.uid == userId &&
            canEditTripAfter(tripId) &&
            validRole(request.resource.data.role)
          );
        allow delete: if isOwner(tripId) ||
          (signedIn() && request.auth.uid == userId && canEditTrip(tripId));
      }

      match /itineraryItems/{itemId} {
        allow read: if canReadTrip(tripId);
        allow create, update: if canEditTripAfter(tripId);
        allow delete: if canEditTrip(tripId);
      }

      match /bookings/{bookingId} {
        allow read: if canReadTrip(tripId);
        allow create, update: if canEditTripAfter(tripId);
        allow delete: if canEditTrip(tripId);
      }

      match /budgetCategories/{categoryId} {
        allow read: if canReadTrip(tripId);
        allow create, update: if canEditTripAfter(tripId);
        allow delete: if canEditTrip(tripId);
      }

      match /channels/{channelId} {
        allow read: if canReadTrip(tripId);
        allow create, update, delete: if canEditTripAfter(tripId);

        match /messages/{messageId} {
          allow read: if canReadTrip(tripId);
          allow create: if signedIn() &&
            canReadTrip(tripId) &&
            request.resource.data.senderId == request.auth.uid;
          allow update, delete: if signedIn() &&
            (
              isOwner(tripId) ||
              resource.data.senderId == request.auth.uid
            );
        }
      }

      match /invites/{inviteId} {
        allow read: if canReadTrip(tripId) ||
          (
            signedIn() &&
            (
              resource.data.inviteeUid == request.auth.uid ||
              resource.data.inviteeEmail == request.auth.token.email
            )
          );
        allow create, update, delete: if isOwner(tripId);
      }

      match /aiRuns/{runId} {
        allow read: if canReadTrip(tripId);
        allow create, update: if canEditTripAfter(tripId);
        allow delete: if isOwner(tripId);
      }
    }

    match /chat_groups/{chatId} {
      allow read: if canReadChat(chatId);
      allow create: if canCreateOwnedChat();
      allow update: if validManagedChatUpdate(chatId) ||
        isLeavingChat(chatId, request.auth.uid) ||
        (
          isChatActiveMember(chatId, request.auth.uid) &&
          chatLastMessageFieldsOnly()
        ) ||
        (
          isAcceptingChatInvite(chatId, request.auth.uid) &&
          chatMemberFieldsOnly()
        );
      allow delete: if isChatOwner(chatId);

      match /members/{userId} {
        allow read: if canReadChat(chatId) ||
          (signedIn() && request.auth.uid == userId);
        allow create: if signedIn() &&
          (
            (
              userId == chatDataAfter(chatId).ownerId &&
              request.resource.data.role == 'owner'
            ) ||
            (
              userId != chatDataAfter(chatId).ownerId &&
              request.resource.data.role in ['admin', 'member']
            )
          ) &&
          validChatMemberStatus(request.resource.data.status) &&
          (
            (
              request.auth.uid == userId &&
              isChatActiveMemberAfter(chatId, userId)
            ) ||
            (
              canInviteToChat(chatId) &&
              request.resource.data.status == 'invited' &&
              request.resource.data.invitedBy == request.auth.uid
            )
          );
        allow update: if signedIn() &&
          (
            (
              userId == chatDataAfter(chatId).ownerId &&
              request.resource.data.role == 'owner'
            ) ||
            (
              userId != chatDataAfter(chatId).ownerId &&
              request.resource.data.role in ['admin', 'member']
            )
          ) &&
          validChatMemberStatus(request.resource.data.status) &&
          (
            (
              canManageChat(chatId) &&
              userId != chatData(chatId).ownerId
            ) ||
            (
              canInviteToChat(chatId) &&
              request.resource.data.status == 'invited' &&
              request.resource.data.invitedBy == request.auth.uid
            ) ||
            (
              request.auth.uid == userId &&
              userId != chatData(chatId).ownerId &&
              (
                isChatActiveMemberAfter(chatId, userId) ||
                request.resource.data.status == 'left'
              )
            )
          );
        allow delete: if (
            canManageChat(chatId) &&
            userId != chatData(chatId).ownerId
          ) ||
          (
            signedIn() &&
            request.auth.uid == userId &&
            userId != chatData(chatId).ownerId
          );
      }

      match /messages/{messageId} {
        allow read: if canReadChat(chatId);
        allow create: if canReadChat(chatId) && validChatMessageCreate();
        allow update, delete: if signedIn() &&
          (
            canManageChat(chatId) ||
            resource.data.senderId == request.auth.uid
          );
      }

      match /invites/{inviteCode} {
        allow read: if canReadChat(chatId) ||
          (
            signedIn() &&
            (
              resource.data.inviteeUid == null ||
              resource.data.inviteeUid == request.auth.uid ||
              resource.data.invitedBy == request.auth.uid
            )
          );
        allow create: if canCreateChatInvite(inviteCode) &&
          request.resource.data.chatId == chatId;
        allow update: if resource.data.chatId == chatId &&
          (
            canResolveChatInvite() ||
            (
              canInviteToChat(chatId) &&
              chatInviteResolutionOnly()
            )
          );
        allow delete: if canInviteToChat(chatId);
      }
    }

    match /chat_invites/{inviteCode} {
      allow read: if signedIn();
      allow create: if canCreateChatInvite(inviteCode);
      allow update: if canResolveChatInvite();
      allow delete: if signedIn() && canInviteToChat(resource.data.chatId);
    }
  }
}
